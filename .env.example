# Which LLM runs the agent: "openai" or "anthropic".
# If unset, OpenAI is used when OPENAI_API_KEY is set, otherwise Claude.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-5.5
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# Shared database. On Railway, add a PostgreSQL database and reference its
# DATABASE_URL here (or paste a Supabase connection string). Without it, an
# embedded database in ./data/pglite is used, which suits one machine only.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# First administrator, created on the first start when there are no staff accounts.
# Sign in with ADMIN_USERNAME (default "admin") and this password, then add employees.
ADMIN_PASSWORD=change-me
# ADMIN_USERNAME=admin

# Optional
PORT=3000
# Data file from the old JSON-file version; imported once on first start if present.
DATA_FILE=./data/db.json
